# Acoustic Guard configuration. Every setting in app/config.py can be overridden here
# with the ACOUSTIC_ prefix. Copy to .env and edit.

# --- service ---
ACOUSTIC_HOST=127.0.0.1
ACOUSTIC_PORT=8001
# required if HOST is anything other than localhost
# ACOUSTIC_API_TOKEN=change-me
# HTTPS - needed to use a browser's microphone from another computer (python scripts/configure.py --lan)
# ACOUSTIC_SSL_CERTFILE=certs/acoustic-guard.crt
# ACOUSTIC_SSL_KEYFILE=certs/acoustic-guard.key
# ACOUSTIC_ENDPOINT_ID=finance-ws-07

# --- microphone --- (index or part of the device name; empty = system default)
# ACOUSTIC_AUDIO_DEVICE=USB

# --- speech ---
# small = balanced (default), base = lighter, large-v3-turbo = most accurate (needs a strong CPU/GPU)
ACOUSTIC_WHISPER_MODEL=small
# second-opinion model for utterances that show risk; empty to disable
ACOUSTIC_VERIFIER_MODEL=large-v3-turbo
# force one language instead of auto-detect (e.g. ur, en); leave unset for auto
# ACOUSTIC_WHISPER_LANGUAGE=ur
ACOUSTIC_TRANSLATE_NON_ENGLISH=true
ACOUSTIC_WHISPER_CPU_THREADS=4

# --- preprocessing --- auto | on | off
ACOUSTIC_NOISE_REDUCTION=auto

# --- privacy ---
ACOUSTIC_STORE_TRANSCRIPT=true
ACOUSTIC_RETENTION_DAYS=30
ACOUSTIC_REQUIRE_CONSENT=true

# --- ExfilGuard backend (Node/Express) ---
# ACOUSTIC_BACKEND_URL=https://exfilguard-backend.local/api/v1/events
# ACOUSTIC_BACKEND_TOKEN=
# ACOUSTIC_BACKEND_HMAC_SECRET=
# ACOUSTIC_BACKEND_MIN_SEVERITY=HIGH
# ACOUSTIC_BACKEND_INCLUDE_TRANSCRIPT=false
