# systemd user unit - runs Acoustic Guard in the logged-in user's session so it can reach
# the PipeWire/PulseAudio microphone.
#   cp deploy/acoustic-guard.service ~/.config/systemd/user/
#   edit WorkingDirectory below, then:
#   systemctl --user daemon-reload && systemctl --user enable --now acoustic-guard
[Unit]
Description=ExfilGuard Acoustic Guard
After=pipewire.service pulseaudio.service network-online.target

[Service]
Type=simple
WorkingDirectory=%h/ExfilGuard_Acoustic
ExecStart=%h/ExfilGuard_Acoustic/venv/bin/python -m app
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
NoNewPrivileges=yes

[Install]
WantedBy=default.target
